# Copy to .env (git-ignored) and change every value. Never commit .env.

# --- Database (local container) ---
POSTGRES_DB=openticket
POSTGRES_USER=openticket
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=55432

# --- App container (only for `docker compose --profile app up`) ---
# Required by the app. Generate with: openssl rand -base64 48
JWT_SIGNING_KEY=
# First admin, created on first start only if no admin exists. Change the password after signing in.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=
APP_PORT=8080

# --- Optional: password reset by email ---
# The address people open (used in email links), e.g. https://tickets.example.com
PUBLIC_URL=
# Any SMTP provider (Brevo and Resend have free tiers). Leave SMTP_HOST empty to turn email off.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=OpenTicket <no-reply@example.com>

# --- Optional: "Continue with GitHub / Google" (leave empty to hide the buttons) ---
# Callback URLs to register: <PUBLIC_URL>/api/v1/auth/external/github/callback and .../google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional: public demo mode (sample data, one-click sign-in as every role) ---
# Only for a dedicated demo instance: anyone can sign in as an admin.
DEMO_ENABLED=false
DEMO_RESET_HOURS=6
